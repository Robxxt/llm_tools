{
  "manifest_version": 2,
  "name": "CV Job Form Filler (verbatim-only)",
  "version": "0.1.0",
  "description": "Fill job forms by copy-pasting verbatim info from your CV using Ollama or any OpenAI-compatible API. Preview before filling; never auto-submits.",
  "permissions": [
    "activeTab",
    "storage",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:5000 http://localhost:5000",
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "CV Job Form Filler"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cvfill-verbatim@example.com",
      "strict_min_version": "109.0"
    }
  }
}
